NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical origin; set the deployed origin for production. Never put OAuth secrets here.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001
# Server-side Gemini credential. Fill only in .env.local; never use NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional model override; leave empty to use the server default in src/lib/ai/config.ts.
GEMINI_MODEL=
# Third-party OpenAI-compatible Claude gateway; secrets stay server-side.
THIRD_PARTY_CLAUDE_API_KEY=
THIRD_PARTY_CLAUDE_BASE_URL=https://gpt.teamsoclo.site/v1
THIRD_PARTY_CLAUDE_MODEL=claude-sonnet-5
AI_DOCUMENT_PROVIDER=gemini
AI_SOLVER_PROVIDER=claude
# Optional isolated E2E accounts. Never prefix test credentials with NEXT_PUBLIC_.
E2E_EMAIL_A=
E2E_PASSWORD_A=
E2E_USER_ID_A=
E2E_EMAIL_B=
E2E_PASSWORD_B=
E2E_USER_ID_B=
